rules_version = '2';

// English Tracker 전용 규칙.
//
// 이 앱은 Patrick 혼자 쓰는 개인 도구라 화면에 로그인이 없다.
// 대신 앱이 열릴 때 익명 계정으로 조용히 로그인하고, 규칙은 그 익명 세션만 통과시킨다.
//
// 이 규칙이 막는 것: 유출된 apiKey를 긁어 인증 없이 Firestore를 훑고 지우는 자동 스캐너.
//   실제로 이번 사건의 구 프로젝트는 이 방어선이 없어 외부에서 읽기·쓰기가 전부 가능했다.
// 이 규칙이 막지 못하는 것: 앱 소스를 읽고 직접 익명 로그인을 흉내내는 사람.
//   영어 학습 기록이라 그 수준까지는 감수한다. 민감한 데이터를 여기 넣지 말 것.
//
// 컬렉션도 두 개로 못박는다. 나중에 다른 데이터가 실수로 섞여 들어와도 규칙이 거부한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /english_days/{day} {
      allow read, write: if isSignedIn();
    }

    match /english_expressions/{expression} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
